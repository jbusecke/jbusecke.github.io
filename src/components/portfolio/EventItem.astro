---
const {
  event,
  presentations = [],
  showVideoLink = true,
  showWebsiteLink = true
} = Astro.props;

import PresentationItem from './PresentationItem.astro';
---

<div
  class="relative mx-12 pb-12 grid md:grid-cols-5 md:gap-10 before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-['']"
>
  <!-- Left Column -->
  <div class="pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span
        class="absolute -left-[42px] text-5xl text-mint-400 rounded-full drop-shadow-[0px_0px_8px_rgba(0,_255,_94,_1)]"
        >&bull;</span
      >
      <h3 class="text-xl font-bold text-mint-400">{event.name}</h3>
      <h4 class="text-xl font-semibold text-zinc-600 dark:text-white">
        {event.location}
      </h4>
      <time datetime={event.date} class="text-sm text-zinc-600/80 dark:text-white/80">
        {event.date}
      </time>
    </div>
  </div>

  <!-- Right Column: Presentations -->
  <div class="flex flex-col gap-4 pb-4 text-zinc-900 dark:text-zinc-300 md:col-span-3">
    <div class="mt-4">
      <h5 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-2">
        Presentations
      </h5>

      {presentations.length > 0 ? (
        <div class="space-y-3">
          {presentations.map(p => (
            <div class="group rounded-xl border border-zinc-200 dark:border-zinc-700 p-4 transition-colors hover:bg-zinc-50 dark:hover:bg-zinc-800">
              <PresentationItem
                presentation={p}
                showVideoLink={showVideoLink}
                showWebsiteLink={showWebsiteLink}
              />
            </div>
          ))}
        </div>
      ) : (
        <p class="text-sm text-gray-400 italic">No presentations listed yet.</p>
      )}
    </div>
  </div>
</div>
