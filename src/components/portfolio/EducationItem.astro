---
const { title, date, location, country, institution, advisor, major, link } = Astro.props;
const displayYear = date ? new Date(date).getFullYear().toString() : '';
---

<div
  class="relative max-w-screen-xl mx-auto px-6 pb-12 grid md:grid-cols-6 md:gap-8"
>
  <div class="pb-12 md:col-span-3">
    <div class="sticky top-0">
      <span
        class="absolute -left-[27px] text-5xl text-mint-400 rounded-full drop-shadow-[0px_0px_8px_rgba(0,_255,_94,_1)]"
        >&bull;</span
      >
      <h3 class="text-xl font-bold text-mint-400">
        {displayYear ? `${displayYear} – ${title}` : title}
      </h3>
      <h4 class="text-xl font-semibold text-zinc-600 dark:text-white">
        {link
          ? <a href={link} target="_blank" rel="noopener noreferrer" class="underline hover:text-mint-600">{institution}</a>
          : institution
        }
      </h4>
    </div>
  </div>
  <div class="flex flex-col gap-2 pb-4 text-zinc-800 dark:text-zinc-300 md:col-span-3">
    <p>{location}, {country}</p>
    <p><strong>Advisor:</strong> {advisor}</p>
    <p><strong>Major:</strong> {major}</p>
  </div>
</div>

