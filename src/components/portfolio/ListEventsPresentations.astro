---
import EventItem from "./EventItem.astro";
import contributions from "../../data/contributions.json";

const {
  events,
  showVideoLink = true,
  showWebsiteLink = true,
} = Astro.props;

// Group contributions by event_id
const contributionsByEvent = {};
for (const c of contributions) {
  const list = contributionsByEvent[c.event_id] ?? [];
  list.push(c);
  contributionsByEvent[c.event_id] = list;
}
---

<div class="relative max-md:mt-0 mt-8 max-w-4xl mx-auto" aria-label="events">
  <div class="space-y-8">
    {
      events.map((event, index) => (
        <article role="article" aria-labelledby={`event-title-${index}`}>
          <EventItem
            event={event}
            contributions={contributionsByEvent[event.id] ?? []}
            showVideoLink={showVideoLink}
            showWebsiteLink={showWebsiteLink}
          />
        </article>
      ))
    }
  </div>
</div>
