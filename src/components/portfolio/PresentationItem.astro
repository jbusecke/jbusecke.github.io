---
const { presentation, showVideoLink = true, showWebsiteLink = true } = Astro.props;
---

<div class="relative group inline-block w-full">
  <span class="inline-block bg-mint-100 dark:bg-mint-900/60 text-mint-800 dark:text-mint-200 text-base font-semibold px-4 py-1 rounded-full cursor-default shadow-sm transition-all">
    {presentation.title}
  </span>

  {(presentation.video_url || presentation.website_url || presentation.slides_url) && (
    <div
      class="absolute left-1/2 -translate-x-1/2 mt-3 min-w-[260px] max-w-[320px] w-max hidden group-hover:flex flex-col items-start bg-gradient-to-tr from-riptide-100 to-white dark:from-mint-950 dark:to-zinc-950 border border-mint-200 dark:border-zinc-800 rounded-2xl px-6 py-4 z-20 text-base shadow-xl transition-all duration-300"
    >
      <p class="text-zinc-800 dark:text-mint-100 font-semibold mb-1">{presentation.speaker}</p>
      {showVideoLink && presentation.video_url && (
        <a
          href={presentation.video_url}
          target="_blank"
          class="text-mint-700 dark:text-mint-300 hover:underline font-medium flex items-center gap-2"
        >
          <span>🎥</span> Watch Video
        </a>
      )}
      {showWebsiteLink && presentation.website_url && (
        <a
          href={presentation.website_url}
          target="_blank"
          class="text-mint-700 dark:text-mint-300 hover:underline font-medium flex items-center gap-2"
        >
          <span>🌐</span> View Website
        </a>
      )}
      {presentation.slides_url && (
        <a
          href={presentation.slides_url}
          target="_blank"
          class="text-mint-700 dark:text-mint-300 hover:underline font-medium flex items-center gap-2"
        >
          <span>📑</span> View Slides
        </a>
      )}
    </div>
  )}
</div>