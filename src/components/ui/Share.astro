---
import { Icon } from "astro-icon/components";

const { tweetText, currentUrl } = Astro.props;

// Use the URL API to ensure no double slashes after the domain
let sanitizedUrl;
try {
  const urlObj = new URL(currentUrl);
  // Remove duplicate slashes in pathname
  urlObj.pathname = urlObj.pathname.replace(/\/{2,}/g, '/');
  sanitizedUrl = urlObj.origin + urlObj.pathname + urlObj.search + urlObj.hash;
} catch (e) {
  sanitizedUrl = currentUrl; // fallback
}

const shareLinks = [
  {
    name: "LinkedIn",
    icon: "linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(sanitizedUrl)}`,
  },
];


---

<div class="flex items-center gap-5 text-lg" role="group" aria-label="Share on social media">
  <span class="text-base font-bold text-blacktext dark:text-white">Share </span>
  {
  shareLinks.map((link) => (
    <a
      href={link.href}
      class="bg-gray-200 dark:bg-gray-800 rounded-full p-2"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Share on ${link.name}`}
      title={`Share on ${link.name}`}
    >
      <Icon 
        name={link.icon} 
        class={link.name === "LinkedIn" ? "text-[#0077B5]" : ""} 
      />
    </a>
  ))
}
</div>
